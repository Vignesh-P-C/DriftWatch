# DriftWatch — environment variables
#
# Copy this file to .env and fill in the values you want to use.
# .env is gitignored — never commit real API keys.
#
# The LLM reasoning layer is optional. Without any provider key set,
# `check` and `watch` still work — they just print raw conflict
# candidates (symbol, files, lines) with no severity or explanation.

# Gemini.
# Get a free-tier key at https://aistudio.google.com/apikey
# No credit card required. Rate limits apply per Google Cloud project,
# not per key — see README for current free-tier numbers, they change.
GEMINI_API_KEY=

# Choose which provider to use. If unset, falls back to Gemini
# automatically when GEMINI_API_KEY is present above (original
# behavior — nothing breaks if you don't add this line).
# Options: gemini | ollama
DRIFTWATCH_LLM_PROVIDER=gemini

# Ollama — free, runs entirely on your own machine, no API key needed.
# Install from https://ollama.com/download, then pull a model with
# e.g. `ollama pull llama3.1` before setting DRIFTWATCH_LLM_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Future providers will be added here as additional env vars
# (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY) — DriftWatch is BYOK and
# never hardcodes a single LLM provider.